PORT=3000

# Closed whitelist of file types, comma-separated (each must match ^[a-z0-9_-]+$)
ALLOWED_TYPES=invoice,receipt,contract,report,statement,certificate,manifest,photo,ticket,backup

# Archival
ARCHIVE_AFTER_MS=3600000
ARCHIVE_SWEEP_INTERVAL_MS=60000
ARCHIVE_BATCH_SIZE=500
ARCHIVE_PATH=./data/archive

# Hot storage — plain byte count or a human-readable size (e.g. "512MB", "1GB")
HOT_MAX_SIZE=512MB
MAX_FILE_SIZE=50MB


# HOT_PATH=./data/hot

# Pagination / batch limits
PAGE_SIZE_DEFAULT=100
PAGE_SIZE_MAX=1000
EXISTS_BATCH_MAX=1000
